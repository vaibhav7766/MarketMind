# Google Gemini API key (AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Provider for stock time-series data (default: yfinance)
STOCK_DATA_PROVIDER=yfinance

# Alpha Vantage API key (optional if using Alpha Vantage instead of yfinance)
ALPHA_VANTAGE_KEY=

# Allowed origins for CORS (comma separated or a single URL)
ALLOWED_ORIGINS=http://localhost:3000